{
  "extends": "tsconfig/base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["node", "jest"],
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["src", "__tests__", "scripts", "*.ts"],
  "exclude": ["dist", "node_modules"]
}
