    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@babel/types": "^7.29.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.41",
    "eslint": "^9.0.0",
    "eslint-config-custom": "workspace:*",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tsconfig": "workspace:*",
    "tsup": "^8.5.1",
